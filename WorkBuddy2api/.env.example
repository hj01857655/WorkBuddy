# workbuddy2api 本地配置（复制为 .env 后填值）
# 令牌不放这里：凭证只读 ~/.workbuddy/checkin/auth.json（归签到脚本所有）

# 本地鉴权 key：设置后 /v1/* 与 /admin/api/* 要求 Authorization: Bearer <key>
# 不设则只监听回环、不校验；要暴露到局域网必须先设
API_KEY=

# 可选：自定义监听地址/端口（默认 127.0.0.1:8377）
# HOST=127.0.0.1
# PORT=8377

# 可选：默认走哪个 realm——cn（国内版，默认）或 intl（国际版）
# 不设则自动：有凭据的槽位优先 cn。单次请求可用请求头 X-WorkBuddy-Realm 或 ?realm= 覆盖。
# WB_REALM=intl
#
# 国际版凭据单独放 ~/.workbuddy/checkin/auth-intl.json（登国内版不会互相覆盖）：
#   python oauth.py --realm global
