{
  "name": "@genie/agent-cli",
  "version": "0.0.0",
  "description": "Use CodeBuddy, Tencent's AI assistant, right from your terminal. CodeBuddy can understand your codebase, edit files, run terminal commands, and handle entire workflows for you.",
  "main": "lib/node/index.js",
  "typings": "lib/node/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/node/index.d.ts",
      "default": "./lib/node/index.js"
    },
    "./server": {
      "types": "./dist-server/types/node/server/index.d.ts",
      "import": "./server.mjs",
      "require": "./server.cjs"
    },
    "./src/node/multitask": {
      "types": "./src/node/multitask/index.ts",
      "default": "./src/node/multitask/index.ts"
    },
    "./node/*": {
      "types": "./src/node/*.ts",
      "default": "./src/node/*.ts"
    },
    "./src/*": {
      "types": "./src/*.ts",
      "default": "./src/*.ts"
    },
    "./*": "./*"
  },
  "license": "SEE LICENSE IN README.md",
  "bin": {
    "codebuddy-code": "./bin/codebuddy",
    "codebuddy": "./bin/codebuddy",
    "cbc": "./bin/codebuddy",
    "cbc-prewarm": "./bin/cbc-prewarm",
    "codebuddy-lowmem": "./bin/codebuddy-lowmem"
  },
  "dependencies": {
    "@a2a-js/sdk": "^1.0.1",
    "@agentclientprotocol/sdk": "^0.25.0",
    "@anthropic-ai/sandbox-runtime": "^0.0.17",
    "@celljs/core": "3.7.8",
    "@celljs/express-adapter": "3.7.8",
    "@celljs/http": "3.7.8",
    "@celljs/mvc": "3.7.8",
    "@celljs/web": "3.7.8",
    "@genie/agent-client-protocol": "workspace:*",
    "@genie/agent-provider": "workspace:*",
    "@genie/at-rest-crypto": "workspace:*",
    "@genie/authentication": "workspace:*",
    "@genie/cbc-tui": "workspace:*",
    "@genie/code-ratio": "workspace:*",
    "@genie/core": "workspace:*",
    "@genie/enterprise-policy": "workspace:*",
    "@genie/product": "workspace:*",
    "@genie/prompts": "workspace:*",
    "@genie/runtime": "workspace:*",
    "@genie/sandbox-cli": "workspace:*",
    "@genie/telemetry": "workspace:*",
    "@lydell/node-pty": "^1.2.0-beta.12",
    "@modelcontextprotocol/sdk": "1.29.0",
    "@openai/agents": "0.5.2",
    "@openai/agents-core": "0.5.2",
    "@opentelemetry/api": "^1.8.0",
    "@tencent/agentdr-sdk": "^1.0.1",
    "@tencent/galileo-node-sdk": "0.3.17-beta.5",
    "@tencent/galileo-semantic-conventions": "^0.2.0",
    "@types/diff-match-patch": "^1.0.36",
    "@types/fuzzy-search": "^2.1.5",
    "@types/semver": "^7.7.1",
    "@types/which": "^3.0.4",
    "@types/yauzl": "^3.4.0",
    "@xterm/headless": "^5.5.0",
    "acorn": "^8.11.3",
    "acorn-walk": "^8.3.4",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "ansi-escapes": "^7.0.0",
    "asciichart": "^1.5.25",
    "async-mutex": "^0.5.0",
    "centrifuge": "^5.5.3",
    "chalk": "^5.4.1",
    "cli-highlight": "^2.1.11",
    "cli-spinners": "^2.9.2",
    "cli-table3": "^0.6.5",
    "cli-truncate": "^4.0.0",
    "commander": "^11.1.0",
    "common-tags": "^1.8.2",
    "diff": "^8.0.2",
    "diff-match-patch": "^1.0.5",
    "e2b": "2.3.6",
    "effect": "4.0.0-rc.112",
    "fast-deep-equal": "^3.1.3",
    "fast-glob": "^3.3.2",
    "figures": "^6.1.0",
    "fs-extra": "^11.3.3",
    "fuzzy-search": "^3.2.1",
    "glob": "^11.0.3",
    "gradient-string": "^3.0.0",
    "http-proxy-agent": "^7.0.2",
    "https-proxy-agent": "^7.0.5",
    "iconv-lite": "^0.6.3",
    "ignore": "^7.0.5",
    "ink": "6.3.1",
    "ink-spinner": "^5.0.0",
    "jimp": "^0.22",
    "jschardet": "^3.1.4",
    "jsonc-parser": "^3.2.0",
    "jsonrepair": "^3.13.0",
    "lru-cache": "^11.1.0",
    "marked": "^16.1.1",
    "minimatch": "^10.0.3",
    "minisearch": "^7.2.0",
    "nano-spawn": "^0.2.0",
    "nunjucks": "3.1.7",
    "openai": "^6.20.0",
    "picomatch": "^2.3.1",
    "postinstall-postinstall": "^2.1.0",
    "qrcode": "^1.5.4",
    "react": "catalog:react19",
    "react-test-renderer": "19.1.2",
    "reverse-line-reader": "0.2.6",
    "rxjs": "^6.6.0",
    "semver": "^7.7.2",
    "shell-quote": "^1.8.3",
    "string-width": "^4.2.3",
    "strip-ansi": "^7.1.0",
    "tar-stream": "^3.1.7",
    "terminal-link": "^5.0.0",
    "turndown": "^7.2.0",
    "undici": "^6.21.3",
    "use-context-selector": "^2.0.0",
    "uuid": "^9.0.1",
    "uuidv7": "^1.2.1",
    "vscode-jsonrpc": "^8.2.0",
    "vscode-languageserver-protocol": "^3.17.5",
    "vscode-uri": "^3.0.7",
    "which": "^5.0.0",
    "ws": "^8.18.3",
    "yaml": "^2.5.1",
    "yauzl": "^3.4.0",
    "zod": "<=3.25.67",
    "zod-to-json-schema": "^3.24.6"
  },
  "optionalDependencies": {
    "koffi": "^2.10.1",
    "@tencent-ai/sandbox-cli-darwin-arm64": "5.6.10",
    "@tencent-ai/sandbox-cli-darwin-x64": "5.6.10",
    "@tencent-ai/sandbox-cli-linux-arm64": "5.6.10",
    "@tencent-ai/sandbox-cli-linux-x64": "5.6.10",
    "@tencent-ai/sandbox-cli-win32-x64": "5.6.10"
  },
  "keywords": [
    "genie-component",
    "cell-component",
    "codebuddy",
    "ai-assistant",
    "terminal",
    "cli"
  ],
  "files": [
    "dist",
    "dist-server",
    "server.cjs",
    "server.mjs",
    "bin",
    "vendor",
    "builtin",
    "CHANGELOG.md",
    "product.json",
    "product.*.json"
  ],
  "homepage": "https://cnb.cool/codebuddy/codebuddy-code",
  "bugs": {
    "url": "https://cnb.cool/codebuddy/codebuddy-code/-/issues"
  },
  "publishConfig": {
    "access": "public",
    "customPackage": {
      "name": "@tencent-ai/codebuddy-code",
      "version": "2.147.0",
      "keywords": [
        "codebuddy",
        "ai-assistant",
        "terminal",
        "cli"
      ],
      "publishConfig": {
        "access": "public"
      },
      "dependencies": {},
      "devDependencies": {},
      "optionalDependencies": {
        "@lydell/node-pty": "1.2.0-beta.14",
        "@lydell/node-pty-darwin-arm64": "1.2.0-beta.14",
        "@lydell/node-pty-darwin-x64": "1.2.0-beta.14",
        "@lydell/node-pty-linux-x64": "1.2.0-beta.14",
        "@lydell/node-pty-win32-arm64": "1.2.0-beta.14",
        "@lydell/node-pty-win32-x64": "1.2.0-beta.14",
        "@tencent-ai/sandbox-cli-darwin-arm64": "5.6.10",
        "@tencent-ai/sandbox-cli-darwin-x64": "5.6.10",
        "@tencent-ai/sandbox-cli-win32-x64": "5.6.10"
      },
      "scripts": {}
    }
  },
  "scripts": {
    "lint": "genie-lint --increase",
    "build:brokered-sandbox-native": "node scripts/build-brokered-sandbox-native.cjs",
    "a2a:inbound": "node scripts/manual-a2a-inbound.mjs",
    "a2a:server": "node --experimental-strip-types scripts/manual-a2a-server.mjs",
    "a2a:session": "node --experimental-strip-types scripts/manual-a2a-session.mjs",
    "build:windows-job": "node scripts/build-windows-job.cjs",
    "build:windows-job:rust": "node scripts/build-windows-job.cjs --rust",
    "check:windows-job": "node scripts/build-windows-job.cjs --check",
    "clean": "rimraf lib dist dist-server dist-workbuddy .dist-headless .dist-lite-wb tsconfig.tsbuildinfo",
    "test:e2e": "vitest run --config vitest.e2e.config.mjs",
    "build:web-ui": "node -e \"const fs=require('fs');fs.rmSync('dist/web-ui',{recursive:true,force:true});fs.cpSync('src/node/remote-gateway/web-ui/dist','dist/web-ui',{recursive:true})\" && node scripts/build-docs.js && node scripts/generate-webui-embed.js",
    "build:builtin-embed": "node scripts/generate-builtin-embed.js",
    "patch": "concurrently \"npx genie patch -s ../../build/patches/cli-saas .\" \"npx genie patch -s ../../build/patches/cli-saas/product.internal.json -n product.internal.json .\" \"npx genie patch -s ../../build/patches/cli-saas/product.ioa.json -n product.ioa.json .\" \"npx genie patch -s ../../build/patches/cli-saas/product.cloudhosted.json -n product.cloudhosted.json .\" \"npx genie patch -s ../../build/patches/cli-saas/product.selfhosted.json -n product.selfhosted.json .\"",
    "package": "node scripts/package-target.js package",
    "package:headless": "node scripts/package-target.js package:headless",
    "package:standalone": "pnpm run package && goreleaser release --snapshot --clean",
    "package:all": "node scripts/package-target.js package:all",
    "package:standalone-all": "pnpm run package:all && goreleaser release --snapshot --clean",
    "dev": "pnpm run patch && cross-env CELL_PROJECT_HOME_PATH=dist cell serve -m externals",
    "dev-proxy": "cross-env HTTP_PROXY=http://localhost:8899 HTTPS_PROXY=http://localhost:8899 NODE_TLS_REJECT_UNAUTHORIZED=0 pnpm run dev",
    "start": "node bin/codebuddy",
    "start-proxy": "pnpm run package && cross-env HTTP_PROXY=http://localhost:8899 HTTPS_PROXY=http://localhost:8899 node bin/codebuddy",
    "serve": "node bin/codebuddy --serve",
    "serve:port": "node bin/codebuddy --serve --port 3000",
    "changeset": "changeset",
    "changeset:merge": "changeset version && git checkout package.json",
    "publish:check": "pnpm run package:all && node ../../build/scripts/cli-publish-check.js",
    "prepublishOnly": "pnpm run package:all && node ../../build/scripts/prepublish.js",
    "bundle": "cross-env USE_RSPACK=1 CELL_NO_WATCH=1 CELL_PROJECT_HOME_PATH=dist cell build -m externals -p && node scripts/lazy-chunk-transform.mjs && node scripts/build-job-broker.cjs",
    "bundle:headless": "pnpm run bundle:headless:build && node scripts/copy-headless-dist.mjs",
    "bundle:lite-wb": "pnpm run bundle:lite-wb:build && node scripts/copy-lite-wb-dist.mjs",
    "bundle:server": "node scripts/build-server.cjs",
    "bundle:headless:build": "cross-env USE_RSPACK=1 CELL_NO_WATCH=1 CELL_PROJECT_HOME_PATH=.dist-headless cell build -m externals,headless -p && node scripts/lazy-chunk-transform.mjs .dist-headless/codebuddy-headless.js lazy-headless",
    "bundle:lite-wb:build": "cross-env USE_RSPACK=1 CELL_NO_WATCH=1 CELL_PROJECT_HOME_PATH=.dist-lite-wb cell build -m externals,headless,lite-wb -p",
    "package:workbuddy": "node scripts/package-target.js package:workbuddy"
  },
  "devDependencies": {
    "@celljs/cli": "3.7.8",
    "@celljs/dev-server": "3.7.8",
    "@changesets/cli": "^2.29.7",
    "@effect/vitest": "4.0.0-rc.112",
    "@genie/cbc-workflow": "workspace:*",
    "@genie/cli": "workspace:*",
    "@genie/style-guide": "workspace:*",
    "@genie/vitest-config": "workspace:*",
    "@rsdoctor/rspack-plugin": "^1.6.3",
    "@rspack/core": "^1.3.0",
    "@types/acorn": "^4.0.6",
    "@types/common-tags": "^1.8.4",
    "@types/diff": "^7.0.2",
    "@types/express": "^4.17.21",
    "@types/fs-extra": "^11.0.4",
    "@types/inquirer": "^9.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "catalog:",
    "@types/nunjucks": "^3.2.6",
    "@types/qrcode": "^1.5.5",
    "@types/react": "catalog:react19",
    "@types/react-test-renderer": "^19.1.0",
    "@types/shell-quote": "^1.7.5",
    "@types/sinon": "^10.0.15",
    "@types/tar-stream": "^3.1.4",
    "@types/turndown": "^5.0.5",
    "@types/uuid": "^9.0.8",
    "@types/ws": "^8.18.1",
    "@types/yazl": "^3.3.0",
    "concurrently": "catalog:",
    "eslint-plugin-no-unsanitized": "^4.1.4",
    "express": "^4.21.0",
    "just-bash": "^3.3.0",
    "memfs": "^4.49.0",
    "node-forge": "^1.4.0",
    "patch-package": "^8.0.0",
    "react-devtools-core": "^6.1.5",
    "selfsigned": "^2.4.1",
    "sinon": "^15.2.0",
    "tcp-websocket": "^1.0.0",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "yazl": "^3.3.1"
  },
  "nx": {
    "targets": {
      "dev": {
        "dependsOn": [
          "^compile",
          "patch"
        ]
      },
      "package": {
        "dependsOn": [
          "build:web-ui"
        ],
        "cache": false,
        "outputs": [
          "{projectRoot}/dist"
        ]
      },
      "package:all": {
        "dependsOn": [
          "build:web-ui",
          "bundle:headless",
          "bundle:lite-wb",
          "bundle:server"
        ],
        "cache": false,
        "outputs": [
          "{projectRoot}/dist"
        ]
      },
      "package:headless": {
        "dependsOn": [
          "bundle:headless"
        ],
        "cache": false,
        "outputs": [
          "{projectRoot}/dist"
        ]
      },
      "test:e2e": {
        "dependsOn": [
          "package:all"
        ]
      },
      "prepublishOnly": {
        "dependsOn": [
          "^compile"
        ]
      },
      "serve": {
        "dependsOn": [
          "package"
        ]
      },
      "build:windows-job": {
        "cache": false,
        "inputs": [
          "{projectRoot}/native/no-orphans/**/*",
          "{projectRoot}/scripts/build-windows-job.cjs"
        ],
        "outputs": [
          "{projectRoot}/bin/native/win32-x64/job-object.node",
          "{projectRoot}/bin/native/win32-arm64/job-object.node",
          "{projectRoot}/bin/native/job-object.d.ts"
        ]
      },
      "build:builtin-embed": {
        "cache": true,
        "inputs": [
          "{projectRoot}/scripts/generate-builtin-embed.js",
          "{projectRoot}/builtin/**/*"
        ],
        "outputs": [
          "{projectRoot}/bun/builtin-embed.js"
        ]
      },
      "patch": {
        "cache": true,
        "inputs": [
          "{workspaceRoot}/build/patches/cli-saas/**/*",
          "{projectRoot}/product.json"
        ],
        "outputs": [
          "{projectRoot}/product.json",
          "{projectRoot}/product.internal.json",
          "{projectRoot}/product.ioa.json",
          "{projectRoot}/product.cloudhosted.json",
          "{projectRoot}/product.selfhosted.json"
        ],
        "dependsOn": [
          "@genie/cli:compile"
        ]
      },
      "bundle": {
        "dependsOn": [
          "^compile",
          "build:builtin-embed",
          "build:windows-job",
          "patch",
          "prepare:cell-runtime"
        ],
        "cache": true,
        "inputs": [
          "production",
          "^production"
        ],
        "outputs": [
          "{projectRoot}/dist/codebuddy.js",
          "{projectRoot}/dist/codebuddy-broker.js",
          "{projectRoot}/dist/lazy"
        ]
      },
      "bundle:headless": {
        "dependsOn": [
          "bundle",
          "bundle:headless:build"
        ],
        "cache": true,
        "inputs": [
          "{projectRoot}/scripts/copy-headless-dist.mjs",
          "{projectRoot}/scripts/bundle-artifacts.js",
          {
            "dependentTasksOutputFiles": "**/.dist-headless/**/*",
            "transitive": false
          }
        ],
        "outputs": [
          "{projectRoot}/dist/codebuddy-headless.js",
          "{projectRoot}/dist/lazy-headless"
        ],
        "executor": "nx:run-commands",
        "options": {
          "command": "node scripts/copy-headless-dist.mjs",
          "cwd": "packages/agent-cli"
        }
      },
      "bundle:lite-wb": {
        "dependsOn": [
          "bundle",
          "bundle:lite-wb:build"
        ],
        "cache": true,
        "inputs": [
          "{projectRoot}/scripts/copy-lite-wb-dist.mjs",
          "{projectRoot}/scripts/bundle-artifacts.js",
          {
            "dependentTasksOutputFiles": "**/.dist-lite-wb/**/*",
            "transitive": false
          }
        ],
        "outputs": [
          "{projectRoot}/dist/codebuddy-lite-wb.mjs",
          "{projectRoot}/dist/lazy-lite-wb"
        ],
        "executor": "nx:run-commands",
        "options": {
          "command": "node scripts/copy-lite-wb-dist.mjs",
          "cwd": "packages/agent-cli"
        }
      },
      "bundle:server": {
        "dependsOn": [
          "bundle"
        ],
        "cache": true,
        "inputs": [
          "production",
          "^production"
        ],
        "outputs": [
          "{projectRoot}/dist-server"
        ]
      },
      "build:web-ui": {
        "dependsOn": [
          "bundle",
          "@genie/agent-cli-web-ui:build"
        ],
        "cache": false,
        "inputs": [
          {
            "dependentTasksOutputFiles": "packages/agent-cli/src/node/remote-gateway/web-ui/dist/**/*",
            "transitive": false
          },
          "{workspaceRoot}/apps/ide/docs/**/*",
          "{projectRoot}/scripts/build-docs.js",
          "{projectRoot}/scripts/generate-webui-embed.js"
        ],
        "outputs": [
          "{projectRoot}/dist/web-ui",
          "{projectRoot}/bun/web-ui-embed.js"
        ]
      },
      "start": {
        "dependsOn": [
          "package"
        ],
        "cache": false
      },
      "prepare:cell-runtime": {
        "command": "node scripts/prepare-cell-runtime.cjs",
        "options": {
          "cwd": "packages/agent-cli"
        },
        "dependsOn": [
          "^compile",
          "build:builtin-embed",
          "build:windows-job",
          "patch"
        ],
        "cache": false
      },
      "bundle:headless:build": {
        "dependsOn": [
          "^compile",
          "build:builtin-embed",
          "build:windows-job",
          "patch",
          "prepare:cell-runtime"
        ],
        "cache": true,
        "inputs": [
          "production",
          "^production",
          {
            "dependentTasksOutputFiles": "**/*",
            "transitive": false
          },
          {
            "env": "CODEBUDDY_DISABLE_LAZY_CHUNKS"
          },
          {
            "env": "CBC_BUNDLE_DUPLICATE_NO_ALIAS"
          },
          {
            "env": "CBC_BUNDLE_DUPLICATE_STRICT"
          },
          {
            "env": "CBC_BUNDLE_DUPLICATE_ALLOW"
          },
          {
            "env": "CBC_BUNDLE_DUPLICATE_REPORT"
          },
          {
            "env": "CBC_LITE_WB_HEAVY_GUARD"
          },
          {
            "env": "CBC_LITE_WB_HEAVY_GUARD_STRICT"
          },
          {
            "env": "CBC_LITE_WB_BUNDLE_STATS"
          },
          {
            "env": "RSDOCTOR"
          },
          {
            "env": "RSDOCTOR_DISABLE_SERVER"
          }
        ],
        "outputs": [
          "{projectRoot}/.dist-headless"
        ]
      },
      "bundle:lite-wb:build": {
        "dependsOn": [
          "^compile",
          "build:builtin-embed",
          "build:windows-job",
          "patch",
          "prepare:cell-runtime"
        ],
        "cache": true,
        "inputs": [
          "production",
          "^production",
          {
            "dependentTasksOutputFiles": "**/*",
            "transitive": false
          },
          {
            "env": "CODEBUDDY_DISABLE_LAZY_CHUNKS"
          },
          {
            "env": "CBC_BUNDLE_DUPLICATE_NO_ALIAS"
          },
          {
            "env": "CBC_BUNDLE_DUPLICATE_STRICT"
          },
          {
            "env": "CBC_BUNDLE_DUPLICATE_ALLOW"
          },
          {
            "env": "CBC_BUNDLE_DUPLICATE_REPORT"
          },
          {
            "env": "CBC_LITE_WB_HEAVY_GUARD"
          },
          {
            "env": "CBC_LITE_WB_HEAVY_GUARD_STRICT"
          },
          {
            "env": "CBC_LITE_WB_BUNDLE_STATS"
          },
          {
            "env": "RSDOCTOR"
          },
          {
            "env": "RSDOCTOR_DISABLE_SERVER"
          }
        ],
        "outputs": [
          "{projectRoot}/.dist-lite-wb"
        ]
      },
      "package:workbuddy": {
        "dependsOn": [
          "bundle:headless:build",
          "bundle:lite-wb:build"
        ],
        "cache": true,
        "inputs": [
          "{projectRoot}/scripts/package-target.js",
          "{projectRoot}/scripts/bundle-artifacts.js",
          {
            "dependentTasksOutputFiles": "**/*",
            "transitive": false
          }
        ],
        "outputs": [
          "{projectRoot}/dist-workbuddy"
        ]
      }
    },
    "implicitDependencies": [
      "@genie/agent-cli-web-ui",
      "@genie/plugin-chat",
      "@genie/plugin-core"
    ]
  }
}
